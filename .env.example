POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=event_booking

# Used when running the app, tests or Alembic from your machine (outside Docker).
# Inside Docker, docker-compose.yml sets DATABASE_URL to point at the `db` service instead.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5434/event_booking

# Signs access tokens. At least 32 characters; generate one with: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Separate database for the test suite (the db-test service). Tests delete all its data.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5435/event_booking_test
